# Supabase (valores reais somente no .env local)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Livre
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_OAUTH_REDIRECT_URI=https://bbtiipnmdxfxnxbemgjr.supabase.co/functions/v1/mercadolivre-oauth-callback

# Edge Functions do funil de expedição (valores reais via Supabase secrets)
BIP_FULFILLMENT_EXPORT_URL=https://bip.oliverhome.com.br/internal/oraculo/fulfillment-events
BIP_FULFILLMENT_EXPORT_SECRET=
FULFILLMENT_DASHBOARD_SECRET=

# --- IA local (Ollama na VPS) — aba /documentacao/perguntar -----------------
# Opcional. Sem OLLAMA_URL a busca funciona normalmente, só sem a leitura por
# IA: o resultado do catálogo (objetos, receita e armadilhas) não depende dela.
#
# A chamada sai da Vercel (iad1) DIRETO para a VPS, sem o n8n no meio. Isso
# tem duas implicações que precisam ser tratadas na infra, não no código:
#   1. A rota pública é protegida por basic auth no Traefik (middleware
#      `ollama-auth`, aplicado em 21/08). OLLAMA_TOKEN vai no formato
#      `usuario:senha` e o app monta o header Basic. Sem ele o endpoint
#      responde 401. O n8n não é afetado: fala com o Ollama pelo host interno
#      `http://ollama:11434`, pela rede JacarttaNet.
#   2. A VPS é COMPARTILHADA. O relatório de Shopee Ads registra modelos de
#      6,6 GB e 9,6 GB derrubando Ollama e workers. Uma busca interativa tem
#      perfil de carga muito diferente de um relatório a cada 3 dias — vale
#      limitar taxa no proxy (Cloudflare) antes de liberar para todo mundo.
# O app já protege o seu lado: timeout de 25s, resposta curta e degradação
# silenciosa se a VPS não responder.
# ATENÇÃO ao path: o Traefik roteia o Ollama em /ollama (PathPrefix + stripprefix).
# A raiz do domínio é o Open WebUI, não a API.
OLLAMA_URL=https://ia.oliverhome.com.br/ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TOKEN=
